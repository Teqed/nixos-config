+// Touch marks the headless sessions serving clientID as active now.
+func (m *HeadlessManager) Touch(clientID string) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, s := range m.sessions {
+		if s.ClientID == clientID {
+			s.LastActivity = time.Now()
+		}
+	}
+}
